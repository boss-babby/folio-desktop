<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Imported PDFs are private working copies, not durable backups. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
