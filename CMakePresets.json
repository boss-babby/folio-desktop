{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    { "name": "dbg", "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "rel", "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" } },

    { "name": "windows-debug",   "inherits": ["base","dbg"], "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" } },
    { "name": "windows-release", "inherits": ["base","rel"], "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" } },

    { "name": "macos-debug",   "inherits": ["base","dbg"], "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64" } },
    { "name": "macos-release", "inherits": ["base","rel"], "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64" } },

    { "name": "linux-debug",   "inherits": ["base","dbg"], "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" } },
    { "name": "linux-release", "inherits": ["base","rel"], "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" } },

    {
      "name": "ios-release",
      "inherits": ["base","rel"],
      "generator": "Xcode",
      "comment": "Qt is static-only on iOS - see plan §2.1. Xcode generator is mandatory for app bundles.",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.0",
        "FOLIO_ENABLE_SIGNING": "ON"
      }
    },
    {
      "name": "android-release",
      "inherits": ["base","rel"],
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Android",
        "CMAKE_ANDROID_ARCH_ABI": "arm64-v8a",
        "CMAKE_ANDROID_API": "26"
      }
    },
    {
      "name": "wasm-release",
      "inherits": ["base","rel"],
      "comment": "Needs COOP/COEP headers at serve time for SharedArrayBuffer - plan §13.1",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "FOLIO_WASM_MINIMAL": "ON",
        "FOLIO_ENABLE_SIGNING": "OFF"
      }
    },
    {
      "name": "core-only",
      "inherits": ["base","dbg"],
      "comment": "Headless core+engine. No display server needed. The fast CI lane.",
      "cacheVariables": { "FOLIO_BUILD_UI": "OFF", "FOLIO_BUILD_TESTS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "macos-release",   "configurePreset": "macos-release" },
    { "name": "linux-release",   "configurePreset": "linux-release" },
    { "name": "ios-release",     "configurePreset": "ios-release" },
    { "name": "android-release", "configurePreset": "android-release" },
    { "name": "wasm-release",    "configurePreset": "wasm-release" },
    { "name": "core-only",       "configurePreset": "core-only" }
  ],
  "testPresets": [
    { "name": "core-only", "configurePreset": "core-only", "output": { "outputOnFailure": true } },
    { "name": "linux-release", "configurePreset": "linux-release", "output": { "outputOnFailure": true } }
  ]
}
