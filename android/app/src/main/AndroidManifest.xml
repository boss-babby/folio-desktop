<?xml version="1.0" encoding="utf-8"?>
<!--
  Folio for Android.

  FolioActivity extends NativeActivity only to connect Android's file picker,
  clipboard and soft keyboard. The UI is still the same C++/Skia surface.
-->
<!-- The applicationId/namespace lives in build.gradle.kts. AGP 8 ignores a
     `package` attribute here and warns about it, so it is deliberately
     absent. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      API 26 is the floor. It is where NativeActivity's input handling,
      AAssetManager and the EGL/GLES3 surface behaviour we rely on are all
      dependable. Gradle owns minSdk/targetSdk; PDF imports use SAF rather
      than requesting broad storage permissions.
    -->

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!--
      Declared, not required: a phone with no stylus must still install.
      The pen paths degrade to touch, which is exactly what the input
      layer does when tool type comes back as FINGER.
    -->
    <uses-feature android:name="android.hardware.touchscreen.multitouch.jazzhand"
                  android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen.multitouch"
                  android:required="false" />

    <application
        android:label="Folio"
        android:icon="@drawable/ic_folio"
        android:hasCode="true"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true">

        <provider
            android:name="ai.folio.reader.PdfShareProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!--
          configChanges lists everything Folio handles itself and must NOT
          be restarted for: an activity recreated on rotation would throw
          away the rendered page cache and the user's scroll position. The
          native side gets APP_CMD_CONFIG_CHANGED instead.
        -->
        <activity
            android:name="ai.folio.reader.FolioActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|smallestScreenSize|uiMode"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">

            <!-- Names the library NativeActivity will dlopen: libfolio-android.so -->
            <meta-data android:name="android.app.lib_name"
                       android:value="folio-android" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Open a PDF from another app (Files, Gmail, Drive). The URI
              is copied from content:// to an app-private cache before PDFium
              reads it; we never mistake the URI for a filesystem path.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
    </application>
</manifest>
